{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xochi.fi/spec/conformance/shielded-recipient.schema.json",
  "title": "Shielded settlement v1 recipient encodings vector set",
  "description": "RecipientDescriptor hashStruct (descriptorDigest) and the stock SchnorrAccount address derivation for the pinned Aztec 5.2.0 and @aztec-labs 6.0.0 classes; the recipient message wrapper with its wide reduction and Schnorr signatures; and the approved acknowledgement structs with cross-type and cross-binding replay refusals (xochi shielded-execution.md §7; product-owner decisions 2026-10-24/25 and 2026-10-29). Generated independently of @xochi/signer; held to the real SDKs by packages/spec/aztec-crosscheck. All keys are TEST ONLY synthetic scalars.",
  "type": "object",
  "required": [
    "version",
    "generator",
    "source",
    "testOnlyKeys",
    "constants",
    "descriptor",
    "recipientMessage",
    "acknowledgements"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 1
    },
    "generator": {
      "type": "string"
    },
    "source": {
      "type": "string"
    },
    "testOnlyKeys": {
      "type": "string"
    },
    "constants": {
      "type": "object",
      "required": [
        "fieldModulus",
        "grumpkinOrder",
        "grumpkinGenerator",
        "domainVersion",
        "bindingDomainName",
        "bindingPurpose"
      ],
      "additionalProperties": false,
      "properties": {
        "fieldModulus": {
          "type": "string",
          "pattern": "^0x[0-9a-f]{64}$"
        },
        "grumpkinOrder": {
          "type": "string",
          "pattern": "^0x[0-9a-f]{64}$"
        },
        "grumpkinGenerator": {
          "type": "object",
          "required": [
            "x",
            "y"
          ],
          "additionalProperties": false,
          "properties": {
            "x": {
              "type": "string",
              "pattern": "^0x[0-9a-f]{64}$"
            },
            "y": {
              "type": "string",
              "pattern": "^0x[0-9a-f]{64}$"
            }
          }
        },
        "domainVersion": {
          "const": "1"
        },
        "bindingDomainName": {
          "const": "Xochi Shielded Recipient"
        },
        "bindingPurpose": {
          "const": "xochi.shielded.recipient-binding.v1"
        }
      }
    },
    "descriptor": {
