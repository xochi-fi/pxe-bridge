                  "classId": {
                    "type": "string",
                    "pattern": "^0x[0-9a-f]{64}$"
                  },
                  "salt": {
                    "type": "string",
                    "pattern": "^0x[0-9a-f]{64}$"
                  },
                  "deployer": {
                    "type": "string",
                    "pattern": "^0x[0-9a-f]{64}$"
                  },
                  "signingPublicKeyX": {
                    "type": "string",
                    "pattern": "^0x[0-9a-f]{64}$"
                  },
                  "signingPublicKeyY": {
                    "type": "string",
                    "pattern": "^0x[0-9a-f]{64}$"
                  },
                  "npkMHash": {
                    "type": "string",
                    "pattern": "^0x[0-9a-f]{64}$"
                  },
                  "ivpkMX": {
                    "type": "string",
